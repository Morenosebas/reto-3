 Adapter -> Record [style=dashed, arrowhead=vee, label=" traduce"];
 Adapter -> Creator [style=dashed, arrowhead=vee, label=" reconstruye con"];
 Adaptee -> Driver [arrowhead=vee, label=" driver  1"];
