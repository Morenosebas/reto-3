digraph State {
  graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="0.7",
         label="Reutiliza · Patrón State", labelloc=t, fontsize=20, fontname="Arial"];
  node [shape=record, fontname="Arial", fontsize=11, style="filled"];
  edge [fontname="Arial", fontsize=10];

  Client [label="{Clientes|UpdateResource\lContactButton\lOwnerActions\l}", fillcolor="#f5f5f5", color="#666666"];

  Context [label="{PublicationStatus\n«Context»|− lifecycle : ListingLifecycle\l|+ code() : ResourceStatus\l+ allowsVisitorContact() : boolean\l+ noticeForVisitor() : string\l+ allowedMoves() : ResourceStatus[]\l+ canMoveTo(next) : boolean\l+ transitionTo(next) : PublicationStatus\l}",
           fillcolor="#fff2cc", color="#d6b656", penwidth=2.5];

  State [label="{«interface»\nListingLifecycle\n«State»|+ code : ResourceStatus\l+ allowsVisitorContact() : boolean\l+ noticeForVisitor() : string\l+ canMoveTo(next) : boolean\l+ allowedMoves() : ResourceStatus[]\l}",
         fillcolor="#dae8fc", color="#6c8ebf"];

  Available [label="{AvailableListing\n«ConcreteState»|+ code = available\l+ allowsVisitorContact() → true\l+ allowedMoves() → reserved, delivered\l}",
             fillcolor="#d5e8d4", color="#82b366"];
  Reserved [label="{ReservedListing\n«ConcreteState»|+ code = reserved\l+ allowsVisitorContact() → false\l+ allowedMoves() → available, delivered\l}",
            fillcolor="#d5e8d4", color="#82b366"];
  Delivered [label="{DeliveredListing\n«ConcreteState»|+ code = delivered\l+ allowsVisitorContact() → false\l+ allowedMoves() → available\l}",
             fillcolor="#d5e8d4", color="#82b366"];

  Client -> Context [label="usa", arrowhead=open];
  Context -> State [label="lifecycle", style=dashed, arrowhead=empty];
  Available -> State [style=dashed, arrowhead=empty];
  Reserved -> State [style=dashed, arrowhead=empty];
  Delivered -> State [style=dashed, arrowhead=empty];
}
