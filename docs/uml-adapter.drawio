        <!-- ═══════════════════════════════════════════════════ -->

        <!-- ValidationError implementa HttpMappable -->
        <mxCell id="e-ve-hm" value="implementa" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=0;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=2;" edge="1" source="ValidationError" target="HttpMappable" parent="1">
