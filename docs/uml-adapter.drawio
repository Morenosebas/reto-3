        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="errorResponse" value="errorResponse( error )" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="530" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ER-body" value="si isHttpMappable(error)&#xa;  → Response( error.httpStatus )&#xa;sino → Response( 500 )" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="errorResponse">
