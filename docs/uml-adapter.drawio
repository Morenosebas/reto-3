        <mxCell id="HM-attrs" value="+httpStatus : number&#xa;+message : string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="HttpMappable">
