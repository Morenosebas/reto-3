        <mxCell id="VE-attrs" value="+httpStatus = 400&#xa;+name = &quot;ValidationError&quot;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="ValidationError">
          <mxGeometry x="0" y="40" width="280" height="35" as="geometry" />
