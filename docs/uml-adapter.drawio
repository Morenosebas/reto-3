        <!-- errorResponse usa HttpMappable (via isHttpMappable) -->
        <mxCell id="e-er-hm" value="usa" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;fontStyle=2;" edge="1" source="errorResponse" target="HttpMappable" parent="1">
