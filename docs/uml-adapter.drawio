        <mxCell id="ValidationError" value="ValidationError" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="280" height="80" as="geometry" />
